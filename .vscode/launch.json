{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "--maxfail=1",
        "--disable-warnings",
        "tests"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Single Test File",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
